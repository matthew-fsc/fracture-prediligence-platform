# Copy to .env and fill in real values. Never commit .env with real secrets.
# All variables without a default value MUST be set before the app will start correctly.

# ── Core ──────────────────────────────────────────────────────────────────────

# development | production
# In production, CLERK_JWKS_URL must be set; the HS256 dev fallback is disabled.
APP_ENV=development

# Local dev default. Production: use your managed Postgres URL (RDS, Neon, Supabase, Railway, etc.).
# Railway: reference the Postgres plugin variable: ${{ Postgres.DATABASE_URL }}
# If your provider requires TLS: postgresql://user:pass@host:5432/db?sslmode=require
DATABASE_URL=postgresql://postgres:password@localhost:5432/prediligence

# Generate with: openssl rand -hex 32
# Never use the example string in production.
SECRET_KEY=change-me-in-production-generate-with-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Comma-separated browser origins allowed for CORS (no trailing slashes).
# Local dev: http://localhost:5173
# Production example: https://app.example.com
CORS_ORIGINS=http://localhost:5173

# Public URL of the SPA — used for Stripe success/cancel redirects and email links.
# Must match the real domain in production and include no trailing slash.
FRONTEND_URL=http://localhost:5173

# ── Admin / Demo ──────────────────────────────────────────────────────────────

# Callers must send X-Admin-Key: <value> to access admin/demo HTTP routes.
# Set a long random string in production; leave blank in local dev if unused.
ADMIN_API_KEY=replace-with-long-random-key

# When set, the generic /demo route is gated — visitors POST /api/demo/verify-access-code
# with this passphrase to receive a demo JWT. Empty = open demo (typical local dev).
# Personalized /demo/:slug links are unaffected.
# DEMO_ACCESS_CODE=your-shared-passphrase

DEMO_TOTAL_SPOTS=20
DEMO_SLUG_RETRY_COUNT=5

# Optional: assign a Clerk user_id (sub) as owner of demo company id=1 on bootstrap.
# Useful for local dev so you can log in as that user and see the demo company.
# SEED_COMPANY_1_OWNER_USER_ID=user_xxx

# ── Auth ──────────────────────────────────────────────────────────────────────

AUTH_JWKS_TTL_SECONDS=3600
AUTH_JWKS_TIMEOUT_SECONDS=5

# --- Clerk ---
# In production (APP_ENV=production) both values are required.
# CLERK_SECRET_KEY: your Clerk backend API key (sk_live_... or sk_test_...)
#   Find it at: https://dashboard.clerk.com → API Keys → Secret keys
CLERK_SECRET_KEY=sk_test_replace_me

# CLERK_JWKS_URL: JWKS endpoint of your Clerk Frontend API instance.
#   Format: https://<your-instance>.clerk.accounts.dev/.well-known/jwks.json
#   Find it at: https://dashboard.clerk.com → API Keys → (your instance URL)
CLERK_JWKS_URL=https://YOUR_INSTANCE.clerk.accounts.dev/.well-known/jwks.json

# ── AI ────────────────────────────────────────────────────────────────────────

# Required for AI Copilot, column-mapping suggestions, and buyer Q simulation.
# Get a key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-replace-me

# ── Payments (Stripe) ─────────────────────────────────────────────────────────

# Find keys at: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_replace_me
# Register webhook endpoint at: https://dashboard.stripe.com/webhooks
# Endpoint URL: https://your-api-domain/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_FOUNDING_PRICE_ID=price_replace_me
STRIPE_PRO_PRICE_ID=price_replace_me
STRIPE_TEAM_PRICE_ID=price_replace_me

# SECURITY: set to false in all environments. Only flip to true when using the
# Stripe CLI for local webhook forwarding AND APP_ENV=development.
# A production deploy that sets this to true will accept unsigned/forged events.
ALLOW_UNSIGNED_STRIPE_WEBHOOKS=false

# ── Email (optional) ──────────────────────────────────────────────────────────
# If SENDGRID_API_KEY is set, client invite emails are sent automatically.
# Leave blank to fall back to log-only mode (advisor copies the link manually).
# SENDGRID_API_KEY=SG.replace_me
# EMAIL_FROM_ADDRESS=noreply@yourdomain.com
# EMAIL_FROM_NAME=Your Firm Name

# ── Storage ───────────────────────────────────────────────────────────────────

# Max CSV/Excel upload size (bytes). Default 26214400 = 25 MiB.
INGESTION_MAX_UPLOAD_BYTES=26214400

# Local filesystem paths for uploads and generated reports.
# In multi-instance (cloud) deployments use a mounted volume or set USE_S3_STORAGE=true.
RAW_DATA_DIR=data/raw
REPORTS_DIR=data/reports
# USE_S3_STORAGE=false
