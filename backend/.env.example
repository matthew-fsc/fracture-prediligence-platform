# Copy to .env and adjust. Never commit .env with real secrets.

# --- Core ---
# development | production  (production requires CLERK_JWKS_URL for Clerk-authenticated routes)
APP_ENV=development

DATABASE_URL=postgresql://postgres:password@localhost:5432/prediligence
# Production: use your managed Postgres URL (RDS, Neon, Supabase, Railway Postgres, etc.).
# Railway: reference the Postgres plugin variable in the dashboard (e.g. ${{ Postgres.DATABASE_URL }}).
# If the provider requires TLS, the URL often includes ?sslmode=require (use the exact string they give).

# openssl rand -hex 32
SECRET_KEY=change-me-in-production-generate-with-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Comma-separated browser origins allowed for CORS (no trailing slashes). Must include your public app URL.
# Example: https://app.example.com
CORS_ORIGINS=https://fracture-prediligence-platform-production.up.railway.app/

# Public URL of the SPA — used for Stripe redirects and emails. Match your real domain in production.
FRONTEND_URL=https://fracture-prediligence-platform-production.up.railway.app/

# If you keep admin/demo HTTP routes, set a long random value and send X-Admin-Key on those requests.
ADMIN_API_KEY=replace-with-long-random-key

AUTH_JWKS_TTL_SECONDS=3600
AUTH_JWKS_TIMEOUT_SECONDS=5

ANTHROPIC_API_KEY=your-api-key-here

# --- Clerk (production: use live keys + JWKS from the same Clerk instance) ---
CLERK_SECRET_KEY=-----BEGIN PUBLIC KEY-----
MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEApKpUItg+08OOIHuJ7/36
155GtwMfLBvcZh45JnRp9NO11ur8tHKrUSynw0kE6h0BlAgx7nk9WGJ4/E4Lep22
O+dEf8ZeI89P8EAtbz1HMaq+ruTn/qGwPgFVm+89vuTYy32ndvgljhMYRpDtIplm
m2zt9NB6W9yQYMrSxun+doLMnpHnUAwy/ksxTwct3m/CFvoJwE3Eui5qIHr1iTi1
Cas39aXH7cFza2KZGOiJWGv4ARomrAFivFJHRZ51Q8TFgZkqtH4LNzcVb2bysIp7
XTtpmIfd80CsXBsr19bQO6SHNnshIYAaDsTcW4GQldyXSda+L9YqmYmMquvPEr6e
sQIDAQAB
-----END PUBLIC KEY-----

# e.g. https://YOUR_INSTANCE.clerk.accounts.dev/.well-known/jwks.json
CLERK_JWKS_URL=https://light-escargot-5.clerk.accounts.dev/.well-known/jwks.json

# --- Stripe (register webhook URL on your public API origin, e.g. https://app.example.com/api/webhooks/stripe) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_FOUNDING_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_TEAM_PRICE_ID=
# Required in production/staging for /api/webhooks/stripe. For local Stripe CLI only:
# APP_ENV=development and ALLOW_UNSIGNED_STRIPE_WEBHOOKS=true (never in production).
ALLOW_UNSIGNED_STRIPE_WEBHOOKS=false

# Max CSV/Excel upload size for ingestion (bytes). Default 26214400 = 25 MiB.
INGESTION_MAX_UPLOAD_BYTES=26214400

DEMO_TOTAL_SPOTS=20
DEMO_SLUG_RETRY_COUNT=5
# When set, generic /demo requires a code from /request-demo (POST /api/demo/verify-access-code). Empty = open demo.
# DEMO_ACCESS_CODE=your-shared-passphrase

# Optional: assign Clerk user id (sub) as owner of demo company id=1 on bootstrap (local dev).
# SEED_COMPANY_1_OWNER_USER_ID=user_xxx

# Persistent paths for uploads/reports — use a volume or object storage in multi-instance deployments.
RAW_DATA_DIR=data/raw
REPORTS_DIR=data/reports
