DATABASE_URL=sqlite:///./prediligence.db
SECRET_KEY=dev-secret-key-change-in-production
ANTHROPIC_API_KEY=

# Clerk — get from https://dashboard.clerk.com
# Set CLERK_JWKS_URL to your instance's JWKS endpoint:
#   Development: https://your-instance.clerk.accounts.dev/.well-known/jwks.json
#   Production:  https://clerk.yourdomain.com/.well-known/jwks.json
CLERK_SECRET_KEY=
CLERK_JWKS_URL=

# Stripe — get from https://dashboard.stripe.com
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_FOUNDING_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_TEAM_PRICE_ID=

# Frontend base URL (for Stripe success/cancel redirect)
FRONTEND_URL=http://localhost:5173
