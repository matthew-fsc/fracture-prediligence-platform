# Copy to frontend/.env for local dev. Vite exposes only variables prefixed with VITE_.

# Clerk (must match the backend CLERK_JWKS_URL instance in production)
VITE_CLERK_PUBLISHABLE_KEY=

# Optional: when the SPA is hosted on a different origin than the API (e.g. SPA on Vercel, API on api.example.com),
# set the API base including scheme, no trailing slash. Leave empty for same-origin / relative /api calls.
# Example: https://api.example.com
VITE_API_BASE_URL=

# Production Docker / Fly / Render: set the same VITE_* values at BUILD time for the image
# (see repo Dockerfile ARG and deploy/README.md). Runtime env vars do not change a built Vite SPA.
