# Copy to .env.local (preferred; gitignored by Vite) or .env.
# Vite only exposes variables prefixed with VITE_ to the browser bundle.
# IMPORTANT: These values are baked into the static build at compile time.
#   Runtime env vars do NOT change a built Vite SPA — always set them before building.

# ── Auth (Clerk) ──────────────────────────────────────────────────────────────

# Your Clerk publishable key (pk_test_... for dev, pk_live_... for prod).
# Find it at: https://dashboard.clerk.com → API Keys
# Must be from the same Clerk instance as the backend's CLERK_JWKS_URL.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# ── API origin ────────────────────────────────────────────────────────────────

# Leave EMPTY for same-origin deployment (SPA and API served from one host).
# The Vite dev server proxies /api → http://127.0.0.1:8000 automatically.
#
# Set to your API base URL (no trailing slash) ONLY when the SPA is hosted on
# a different origin than the API (e.g. SPA on Vercel, API on api.example.com).
# Example: https://api.example.com
VITE_API_BASE_URL=

# ── Analytics (PostHog) ───────────────────────────────────────────────────────

# Optional. Leave blank to disable PostHog event tracking.
# Find it at: https://app.posthog.com → Project Settings → Project API Key
VITE_POSTHOG_KEY=
